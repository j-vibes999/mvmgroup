---
import Shell from '../../../layouts/Shell.astro';
import { getSite, langPaths } from '../../../lib/site';
import { md } from '../../../lib/markdown';
import { breadcrumbLd } from '../../../lib/seo';
import { formatDate, t, type Lang } from '../../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const l = getSite().legal(lang);
const title = l.privacy_title || t(lang, 'footer.privacy');
const trail = [{ label: title }];
---
<Shell lang={lang} path={['privacy']} title={title} description={title} jsonLd={breadcrumbLd(lang, trail)} win={{ title, icon: 'document', trail }}>
  {l.updated && <p class="muted">{t(lang, 'misc.updated')}: {formatDate(l.updated, lang)}</p>}
  <div class="prose" set:html={md(l.privacy_body)} />
</Shell>
