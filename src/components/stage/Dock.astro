---
import AppTile from '../AppTile.astro';
import { menuFor } from './menu';
import { t, type Lang } from '../../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<nav class="dock" data-dock aria-label={t(lang, 'nav.menu')}>
  {menuFor(lang).map((m) => <a href={m.href} data-win-link><AppTile icon={m.icon} />{m.label}</a>)}
</nav>
