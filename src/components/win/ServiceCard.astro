---
import AppTile from '../AppTile.astro';
import { t, url, type Lang } from '../../lib/i18n';
import type { Entry } from '../../lib/content';
interface Props { lang: Lang; item: Entry }
const { lang, item: s } = Astro.props;
---
<a class="card svc" href={url(lang, 'services', s.slug)} data-win-link>
  <div class="card__body">
    <AppTile icon={s.icon} />
    <h3>{s.title}</h3>
    <p>{s.summary}</p>
    <span class="link-arrow card__foot">{t(lang, 'cta.learnMore')} →</span>
  </div>
</a>
