---
import AppTile from '../AppTile.astro';
import { t, url, type Lang } from '../../lib/i18n';
import type { Entry } from '../../lib/content';
interface Props { lang: Lang; item: Entry; /** Heading level for the card title (h2 on listing pages without section headings). */ level?: 'h2' | 'h3' }
const { lang, item: b, level: H = 'h3' } = Astro.props;
const others = [b.name_la, b.name_en, b.name_zh].filter((n) => n && n !== b.title);
---
<article class="card brand-card">
  <div class="card__body">
    <AppTile icon="jar" logo={b.logo} />
    <H>{b.title}</H>
    {others.length > 0 && <p class="card__meta">{others.join(' · ')}</p>}
    {b.summary && <p>{b.summary}</p>}
    <div class="hero-actions card__foot">
      <a class="btn btn--sm" href={url(lang, 'brands', b.slug)}>{t(lang, 'cta.viewBrand')}</a>
      <a class="link-arrow" href={`${url(lang, 'partnership')}?type=distributor&brand=${b.slug}`}>{t(lang, 'cta.becomeDistributor')} →</a>
    </div>
  </div>
</article>
